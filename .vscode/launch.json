// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"compounds": [
		{
			"name": "Extension",
			"configurations": [
				"Client-Debug",
				"Server-Debug"
			]
		}
	],
	"configurations": [
		{
			"name": "Client-Debug",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--profile-temp",
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}",
			"presentation": {
				"hidden": true,
				"group": "Debug"
			}
		},
		{
			"name": "Server-Debug",
			"type": "node",
			"request": "attach",
			"port": 6010,
			"restart": false,
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"presentation": {
				"hidden": true,
				"group": "Debug"
			}
		},
		{
			"name": "Debug Server Tests",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
			"args": [
				"--config",
				"tests/server-test/.mocharc.json",
				"--no-timeouts"
			],
			"cwd": "${workspaceFolder}",
			"sourceMaps": true,
			"resolveSourceMapLocations": [
				"${workspaceFolder}/tests/server-test/**",
				"${workspaceFolder}/packages/server/**",
				"${workspaceFolder}/packages/shared/**"
			],
			"outFiles": [
				"${workspaceFolder}/tests/server-test/out/**/*.js",
				"${workspaceFolder}/packages/server/out/**/*.js",
				"${workspaceFolder}/packages/shared/out/**/*.js"
			],
			"preLaunchTask": "compile: tests"
		}
	]
}
