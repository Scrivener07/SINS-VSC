{
	"name": "soase",
	"displayName": "Sins of a Solar Empire",
	"description": "Developer tools and language support for Sins of a Solar Empire.",
	"publisher": "Scrivener",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.106.1"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"*"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"configuration": {
			"properties": {
				"soase2-plugin.game-installation": {
					"type": "string",
					"scope": "window",
					"description": "A directory path to the Sins of a Solar Empire 2 installation directory."
				},
				"soase2-plugin.language": {
					"type": "string",
					"scope": "application",
					"default": "en",
					"enum": [
						"en",
						"de",
						"es",
						"fr",
						"hu",
						"it",
						"ja",
						"ko",
						"pl",
						"pt_br",
						"ru",
						"th",
						"tr",
						"zh_cn"
					],
					"description": "A language code for the prefered primary `*.localized_text` dictionary to display."
				}
			}
		},
		"languages": [
			{
				"id": "soase",
				"configuration": "./syntaxes/language-configuration.json",
				"icon": {
					"dark": "./packages/shared/images/sins2_icon_transparent.png",
					"light": "./packages/shared/images/sins2_icon_transparent.png"
				},
				"aliases": [
					"Sins Data"
				],
				"extensions": [
					".mod_meta_data",
					".localized_text",
					".uniforms",
					".ability",
					".action_data_source",
					".buff",
					".entity_manifest",
					".exotic",
					".flight_pattern",
					".formation",
					".npc_reward",
					".player",
					".player_color_group",
					".player_icon",
					".player_portrait",
					".research_subject",
					".cursor",
					".unit_item",
					".unit_skin",
					".unit",
					".weapon",
					".named_colors",
					".death_sequence",
					".death_sequence_group",
					".beam_effect",
					".exhaust_trail_effect",
					".particle_effect",
					".shield_effect",
					".font",
					".gravity_well_props",
					".button_style",
					".drop_box_style",
					".gui",
					".label_style",
					".list_box_style",
					".reflect_box_style",
					".scroll_bar_style",
					".text_entry_box_style",
					".brush",
					".mesh_material",
					".skybox",
					".sound",
					".texture_animation",
					".gdpr_accept_data",
					".playtime_message",
					".welcome_message",
					".start_mode"
				]
			}
		],
		"grammars": [
			{
				"language": "soase",
				"scopeName": "source.soase",
				"path": "./syntaxes/soase.tmLanguage.json"
			}
		],
		"commands": [
			{
				"command": "soase.helloWorld",
				"title": "Hello World"
			},
			{
				"command": "soase.research.visualizer.open",
				"title": "Open Research Visualizer",
				"icon": "$(graph)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "soase.research.visualizer.open",
					"group": "navigation",
					"when": "editorLangId == 'soase'"
				}
			]
		}
	},
	"workspaces": [
		"packages/*",
		"tests/*"
	],
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile:packages:shared": "tsc -b packages/shared",
		"compile:packages:server": "tsc -b packages/server",
		"compile:packages:client": "tsc -b packages/client",
		"compile:packages": "npm run compile:packages:shared && npm run compile:packages:server && npm run compile:packages:client",
		"compile:tests:server": "tsc -b tests/server-test",
		"compile:tests:client": "tsc -b tests/client-test",
		"compile:tests": "npm run compile:packages && npm run compile:tests:server && npm run compile:tests:client",
		"compile:extension": "npm run compile:packages:shared && webpack",
		"compile": "npm run compile:extension && npm run compile:tests",
		"watch:packages:shared": "tsc -b -w packages/shared",
		"watch:packages:server": "tsc -b -w packages/server",
		"watch:packages:client": "tsc -b -w packages/client",
		"watch:tests": "tsc -b -w",
		"watch:extension": "npm run compile:packages:shared && webpack --watch",
		"test:packages:server": "npm run compile:tests && npm run compile:extension && mocha --config tests/server-test/.mocharc.json",
		"test:packages:server:diagnostic": "npm run compile:tests && mocha --config tests/server-test/.mocharc.diagnostic.json",
		"test:extension": "npm run compile:tests && npm run compile:extension && vscode-test",
		"test": "vscode-test",
		"clean:packages:shared": "tsc -b --clean packages/shared",
		"clean:packages:server": "tsc -b --clean packages/server",
		"clean:packages:client": "tsc -b --clean packages/client",
		"clean:tests:server": "tsc -b --clean tests/server-test",
		"clean:tests:client": "tsc -b --clean tests/client-test",
		"clean:tests": "npm run clean:tests:server && npm run clean:tests:client",
		"clean:build:dist": "node -e \"require('fs').rmSync('dist',{recursive:true, force:true})\"",
		"clean:build:vscode-test": "node -e \"require('fs').rmSync('.vscode-test',{recursive:true, force:true})\"",
		"clean": "tsc -b --clean && npm run clean:build:dist",
		"reset": "node scripts/reset.mjs",
		"pretest": "npm run compile:tests && npm run compile:extension && npm run lint",
		"lint": "eslint packages/*/src/*",
		"package": "npm run compile:packages:shared && webpack --mode production --devtool hidden-source-map"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "22.x",
		"@types/vscode": "^1.106.1",
		"@typescript-eslint/eslint-plugin": "^8.42.0",
		"@typescript-eslint/parser": "^8.42.0",
		"@vscode/test-cli": "^0.0.11",
		"@vscode/test-electron": "^2.5.2",
		"copy-webpack-plugin": "^13.0.1",
		"eslint": "^9.34.0",
		"mocha": "^11.7.5",
		"ts-loader": "^9.5.4",
		"typescript": "^5.9.2",
		"webpack": "^5.101.3",
		"webpack-cli": "^6.0.1"
	}
}
