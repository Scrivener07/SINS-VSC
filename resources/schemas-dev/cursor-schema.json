{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"texture_name",
		"hot_spot"
	],
	"properties": {
		"texture_name": {
			"$ref": "#/$defs/brush_ptr"
		},
		"hot_spot": {
			"type": "array",
			"items": {
				"type": "number"
			},
			"minItems": 2,
			"maxItems": 2
		}
	},
	"$defs": {
		"brush_ptr": {
			"type": "string"
		}
	}
}