{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"mesh_not_visible_time": {
			"type": "number"
		},
		"events": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"attached_to_unit": {
						"type": "boolean"
					},
					"location": {
						"type": "string",
						"enum": [
							"center",
							"surface"
						]
					},
					"time": {
						"type": "number"
					},
					"particle_effects": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"sounds": {
						"type": "array",
						"items": {
							"type": "string"
						}
					}
				}
			}
		}
	}
}