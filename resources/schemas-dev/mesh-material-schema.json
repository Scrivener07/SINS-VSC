	"type": "object",
	"additionalProperties": false,
	"properties": {
		"base_color_texture": {
			"$ref": "#/$defs/file_texture_ptr"
		},
		"normal_texture": {
			"$ref": "#/$defs/file_texture_ptr"
		},
		"mask_texture": {
			"$ref": "#/$defs/file_texture_ptr"
		},
		"occlusion_roughness_metallic_texture": {
			"$ref": "#/$defs/file_texture_ptr"
		},
