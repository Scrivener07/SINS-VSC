{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2024",
		"outDir": "out",
		"rootDir": "src",
		"lib": [
			"ES2024"
		],
		"sourceMap": true,
		"strict": true,
		"types": [
			"mocha",
			"node"
		],
		"paths": {
			"@soase/server/*": [
				"../../packages/server/src/*"
			],
			"@soase/server": [
				"../../packages/server/src"
			],
			"@soase/shared/*": [
				"../../packages/shared/src/*"
			],
			"@soase/shared": [
				"../../packages/shared/src"
			]
		},
		"baseUrl": "."
	},
	"include": [
		"src/**/*"
	],
	"references": [
		{
			"path": "../../packages/server"
		},
		{
			"path": "../../packages/shared"
		}
	]
}
